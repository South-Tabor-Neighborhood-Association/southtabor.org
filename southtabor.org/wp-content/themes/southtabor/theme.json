{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "paper", "name": "Paper", "color": "#f5f7f1" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "moss", "name": "Moss", "color": "#dfe6d5" },
				{ "slug": "fir", "name": "Fir", "color": "#435339" },
				{ "slug": "on-fir", "name": "On fir", "color": "#ffffff" },
				{ "slug": "band", "name": "Band", "color": "#2b3725" },
				{ "slug": "on-band", "name": "On band", "color": "#f5f7f1" },
				{ "slug": "on-band-muted", "name": "On band muted", "color": "#b9c6ad" },
				{ "slug": "ink", "name": "Ink", "color": "#1d2419" },
				{ "slug": "ink-muted", "name": "Ink muted", "color": "#535e4c" },
				{ "slug": "marigold", "name": "Marigold", "color": "#e2a52b" },
				{ "slug": "on-marigold", "name": "On marigold", "color": "#1d2419" },
				{ "slug": "line", "name": "Line", "color": "#c9d1bf" },
				{ "slug": "line-strong", "name": "Line strong", "color": "#6f7a66" },
				{ "slug": "focus", "name": "Focus", "color": "#2457a6" },
				{ "slug": "alert", "name": "Alert", "color": "#a8281f" },
				{ "slug": "alert-bg", "name": "Alert background", "color": "#f8e4e0" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Zilla Slab",
					"fontFamily": "\"Zilla Slab\", Rockwell, \"Roboto Slab\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Zilla Slab", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ZillaSlab-Medium.woff2" ] },
						{ "fontFamily": "Zilla Slab", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ZillaSlab-SemiBold.woff2" ] },
						{ "fontFamily": "Zilla Slab", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ZillaSlab-Bold.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Public Sans",
					"fontFamily": "\"Public Sans\", \"Helvetica Neue\", Arial, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Public Sans", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/PublicSans-Variable.woff2" ] },
						{ "fontFamily": "Public Sans", "fontWeight": "400 700", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/PublicSans-Italic-Variable.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "meta", "name": "Meta", "size": "13px", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "15px", "fluid": false },
				{ "slug": "body", "name": "Body", "size": "17px", "fluid": false },
				{ "slug": "lead", "name": "Lead", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
				{ "slug": "heading-3", "name": "Heading 3", "size": "21px", "fluid": { "min": "19px", "max": "21px" } },
				{ "slug": "heading-2", "name": "Heading 2", "size": "28px", "fluid": { "min": "24px", "max": "28px" } },
				{ "slug": "heading-1", "name": "Heading 1", "size": "38px", "fluid": { "min": "30px", "max": "38px" } },
				{ "slug": "display", "name": "Display", "size": "52px", "fluid": { "min": "36px", "max": "52px" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1 · 4px", "size": "4px" },
				{ "slug": "20", "name": "2 · 8px", "size": "8px" },
				{ "slug": "30", "name": "3 · 12px", "size": "12px" },
				{ "slug": "40", "name": "4 · 16px", "size": "16px" },
				{ "slug": "50", "name": "5 · 24px", "size": "24px" },
				{ "slug": "60", "name": "6 · 32px", "size": "32px" },
				{ "slug": "70", "name": "7 · 48px", "size": "clamp(32px, 5vw, 48px)" },
				{ "slug": "80", "name": "8 · 72px", "size": "clamp(48px, 7vw, 72px)" }
			]
		},
		"border": {
			"radius": true,
			"radiusSizes": [
				{ "slug": "sm", "name": "Small", "size": "3px" },
				{ "slug": "md", "name": "Medium", "size": "6px" },
				{ "slug": "round", "name": "Round", "size": "9999px" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "menu", "name": "Menu", "shadow": "0 8px 24px rgba(29,36,25,0.18)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "max(16px, var(--wp--preset--spacing--50))",
				"right": "max(16px, var(--wp--preset--spacing--50))"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--fir)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--ink)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--focus)", "offset": "2px", "style": "solid", "width": "2px" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.2", "textWrap": "balance" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-1)", "lineHeight": "1.16" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-2)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-3)", "lineHeight": "1.33" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--body)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--fir)", "text": "var(--wp--preset--color--on-fir)" },
				"border": { "radius": "var(--wp--preset--border-radius--md)", "width": "2px", "style": "solid", "color": "transparent" },
				"spacing": { "padding": { "top": "var(--wp--preset--spacing--30)", "bottom": "var(--wp--preset--spacing--30)", "left": "var(--wp--preset--spacing--50)", "right": "var(--wp--preset--spacing--50)" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "lineHeight": "1.33" },
				":hover": { "color": { "background": "var(--wp--preset--color--band)", "text": "var(--wp--preset--color--on-band)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--focus)", "offset": "2px", "style": "solid", "width": "2px" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--ink-muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--meta)" }
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600" }
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--ink-muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--meta)", "fontWeight": "500" }
			},
			"core/post-excerpt": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "lineHeight": "1.47" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--moss)", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--50)" } }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sidebar", "title": "Sidebar", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page without sidebar", "postTypes": [ "page" ] }
	]
}
