#!/bin/bash

# Pre-commit hook to detect potential secrets

# Define patterns to search for (case-insensitive)
PATTERNS="api_key|apikey|secret_key|secretkey|aws_access_key|password\s*=\s*['\"][^'\"]{8,}['\"]|define\(\s*['\"]DB_PASSWORD['\"]\s*,\s*['\"][^'\"]{8,}['\"]"

# Get a list of staged files (Added, Copied, Modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

SECRETS_FOUND=0

for FILE in $STAGED_FILES; do
  # Ignore the hook script itself to prevent false positives when modifying it
  if [[ "$FILE" == ".githooks/pre-commit" ]]; then
    continue
  fi

  # Search only the added lines in the diff (lines starting with + but not +++)
  MATCHES=$(git diff --cached "$FILE" | grep "^+" | grep -v "^+++" | grep -iE "$PATTERNS")
  
  if [ ! -z "$MATCHES" ]; then
    echo "🚨 ERROR: Potential secret detected in staged file: $FILE"
    echo "Offending lines:"
    # Print the matches, replacing the leading '+' with '  > ' for readability
    echo "$MATCHES" | sed 's/^+/  > /'
    echo ""
    SECRETS_FOUND=1
  fi
done

if [ $SECRETS_FOUND -eq 1 ]; then
  echo "❌ Commit rejected because it looks like you are committing a secret."
  echo "If this is a false positive (e.g., a placeholder password like 'your_dev_password'),"
  echo "you can bypass this check by running your commit command with the --no-verify flag:"
  echo "  git commit -m \"your message\" --no-verify"
  exit 1
fi

exit 0
